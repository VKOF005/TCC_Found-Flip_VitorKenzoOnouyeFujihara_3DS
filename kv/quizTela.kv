        #navbar inferior

        Image:
            source:"imgs/VNavB1.png"
            pos_hint:{"right": 0.96,"top": 0.14}
            size_hint:0.92 , 0.07





        # Usando grid layout para não precisar declarar a posição e tamanho
        # de cada elemento, além disso ele irá dividir igualmente dentro do
        # layout. caso não funcione, aplicar o mesmo estilo da navbar
        # superior.

        GridLayout:
            rows: 1
            pos_hint:{"right": 0.96,"top": 0.09}
            size_hint:0.92 , 0.07
            canvas:
                Color
                    rgb: utils.get_color_from_hex("27DF07")
                RoundedRectangle
                    size: self.size
                    pos: self.pos
                    radius: [40]







            ImageButton:
                on_release:print("1")
                source:"imgs/icone1.png"
            ImageButton:
                on_release:print("2")
                source:"imgs/icone2.png"
            ImageButton:
                on_release:print("3")
                source:"imgs/icone3.png"
            ImageButton:
                on_release:print("4")
                source:"imgs/icone4.png"
            ImageButton:
                on_release:print("configurações")
                source:"imgs/configuracoes.png"



